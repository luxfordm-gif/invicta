{#
  INTERNAL, not linked from anywhere. Three layouts of the same section, same
  three case studies, so they can be judged like for like. Delete this file once
  a layout is chosen.
#}
{% set labPicks = ["lk-effingham", "uppark-sussex", "u-farm-kent"] %}
{% set labStudies = [] %}
{% for id in labPicks %}{% for cs in caseStudies %}{% if cs.id == id %}{% set _ = labStudies.push(cs) %}{% endif %}{% endfor %}{% endfor %}

    <section class="section lab-hero">
      <div class="container">
        <p class="eyebrow">Internal comparison</p>
        <h1 class="statement">Three case study <span class="em">layouts.</span></h1>
        <p class="lab-hero__lead">The same three projects, the same content, four arrangements. A is what is on the site now. B and C are shorter and move the arrows out to the section edges, on the new iOS-style page dots. D is the bento from the Figma, which shows all three at once instead of one at a time.</p>
      </div>
    </section>

    <div class="lab-label"><div class="container"><p><strong>A &mdash; Stack</strong> (current) &middot; header block, then a 1:1 split of 4:3 photo and copy</p></div></div>
    {% set studies = labStudies %}
    {% set carouselId = "lab-a" %}
    {% set carouselVariant = "stack" %}
    {% set carouselSurface = "section--paper" %}
    {% set carouselTitle = "Projects like this, <span class='em'>across the South East.</span>" %}
    {% set carouselLead = "A few of the supplies we've designed, installed and looked after. Step through to see the work." %}
    {% include "case-carousel.njk" %}

    <div class="lab-label"><div class="container"><p><strong>B &mdash; Split</strong> &middot; header on one row, wider 16:9 photo, copy beside it, arrows at the edges</p></div></div>
    {% set studies = labStudies %}
    {% set carouselId = "lab-b" %}
    {% set carouselVariant = "split" %}
    {% set carouselSurface = "section--light" %}
    {% include "case-carousel.njk" %}

    <div class="lab-label"><div class="container"><p><strong>C &mdash; Mirror</strong> &middot; copy first, photo right at a capped height, arrows at the edges</p></div></div>
    {% set studies = labStudies %}
    {% set carouselId = "lab-c" %}
    {% set carouselVariant = "mirror" %}
    {% set carouselSurface = "section--paper" %}
    {% include "case-carousel.njk" %}

    <div class="lab-label"><div class="container"><p><strong>D &mdash; Bento</strong> &middot; from the Figma: all three at once on navy, copy over the photo, outcome line slides up on hover</p></div></div>
    {% set studies = labStudies %}
    {% set carouselId = "lab-d" %}
    {% set carouselTitle = "Projects like this, <span class='em'>across the South East.</span>" %}
    {% set carouselLead = "A few of the projects we've designed, installed and looked after." %}
    {% include "case-bento.njk" %}

    <section class="section lab-foot">
      <div class="container">
        <p class="eyebrow">Measured heights</p>
        <div class="rule"></div>
        <ul class="lab-metrics" id="lab-metrics"></ul>
      </div>
    </section>

    <script>
      // Prints the rendered height of each section so the comparison is a number,
      // not an impression. Internal page only.
      addEventListener("load", function () {
        var out = document.getElementById("lab-metrics");
        var names = { "lab-a": "A, Stack (current)", "lab-b": "B, Split", "lab-c": "C, Mirror", "lab-d": "D, Bento (all three at once)" };
        Object.keys(names).forEach(function (id) {
          var sec = document.getElementById("cc-title-" + id) || document.getElementById("bento-title-" + id);
          if (!sec) return;
          var section = sec.closest("section");
          var li = document.createElement("li");
          li.innerHTML = "<span>" + names[id] + "</span><strong>" + Math.round(section.offsetHeight) + "px</strong>";
          out.appendChild(li);
        });
      });
    </script>
