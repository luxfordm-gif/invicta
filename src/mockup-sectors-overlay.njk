  "robots": "noindex, nofollow",
  "eleventyExcludeFromCollections": true
}
---
{#
  BUILD-TIME MOCKUP — not linked from anywhere, noindex. Explores the
  "image is the whole card, copy over a frosted-gradient top" treatment for the
  mobile sectors carousel, without touching the real .sector styles. Delete this
  file (and remove the branch) once a direction is chosen. Best viewed at phone
  width. All classes are namespaced .ovsec* so nothing here affects the live site.
#}
<style>
  .ovmock { padding-block: clamp(48px, 9vw, 96px); }
  .ovmock__note { margin-top: var(--flow-md); max-width: 46ch; font-size: 17px; line-height: 1.5; color: var(--on-dark-muted); }

  .ovsectors {
    display: flex; gap: var(--space-2);
    margin-top: var(--flow-lg);
    margin-inline: calc(-1 * var(--container-pad));
    padding-inline: var(--container-pad);
    padding-block: 4px 6px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-pad);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .ovsectors::-webkit-scrollbar { display: none; }

  /* The card IS the image: a tall tile with the photo full-bleed behind it. */
  .ovsector {
    position: relative;
    flex: 0 0 82%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    aspect-ratio: 5 / 8;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line-dark);
    background: var(--ground-raise);
  }
  .ovsector > img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  /* Frosted gradient header: a dark top scrim + a blur that fades out downward
     (mask-image), so the copy is legible over any photo but the image stays
     clear below. This is the piece that makes text-over-image work. */
  .ovsector__head {
    position: absolute; top: 0; left: 0; right: 0;
    padding: var(--space-4) var(--space-3) var(--space-7);
    background: linear-gradient(to bottom,
      rgba(6, 16, 34, 0.88) 0%,
      rgba(6, 16, 34, 0.55) 52%,
      rgba(6, 16, 34, 0) 100%);
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
  }
  .ovsector__title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(24px, 6.6vw, 30px); letter-spacing: -0.02em; line-height: 1.05;
    color: var(--on-dark);
  }
  .ovsector__desc {
    margin-top: var(--space-2);
    font-size: 15px; line-height: 1.5;
    color: rgba(255, 255, 255, 0.84);
    max-width: 34ch;
  }

  .ovdots { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: var(--space-4); }
  .ovdots i { width: 7px; height: 7px; border-radius: 999px; background: rgba(255, 255, 255, 0.24); }
  .ovdots i:first-child { width: 22px; background: var(--on-dark); }

  /* Keep the mockup honest to phone layout even if viewed on a wider screen. */
  @media (min-width: 640px) {
    .ovsectors { max-width: 430px; }
    .ovsector { flex-basis: 78%; }
  }
</style>

<section class="section ovmock" aria-label="Sectors overlay mockup">
  <div class="container">
    <p class="eyebrow">Sectors — mockup</p>
    <div class="rule"></div>
    <h2 class="statement">Where we work.</h2>
    <p class="ovmock__note">Swipe to view our key environments. The second tile peeks in to indicate additional sectors.</p>

    <div class="ovsectors">
      <article class="ovsector">
        <img src="/assets/sector-estates.webp" alt="A grand country estate at dawn, approached by a long tree-lined avenue across misty parkland." loading="eager">
        <div class="ovsector__head">
          <h3 class="ovsector__title">Landed estates</h3>
          <p class="ovsector__desc">High-volume private supplies serving multiple properties and estate operations from a single, well-understood source.</p>
        </div>
      </article>

      <article class="ovsector">
        <img src="/assets/sector-country-houses.webp" alt="A Cotswold-stone country house behind clipped formal hedging on a frosty morning." loading="eager">
        <div class="ovsector__head">
          <h3 class="ovsector__title">Country houses</h3>
          <p class="ovsector__desc">Independent water for rural homes off the mains, or with a connection they would rather not depend on.</p>
        </div>
      </article>

      <article class="ovsector">
        <img src="/assets/sector-institutions.webp" alt="A historic college quad with a stone bell tower and manicured lawn in low sun." loading="eager">
        <div class="ovsector__head">
          <h3 class="ovsector__title">Institutions</h3>
          <p class="ovsector__desc">Reliable, compliant supply for schools, clubs, sporting venues and commercial sites with demanding requirements.</p>
        </div>
      </article>

      <article class="ovsector">
        <img src="/assets/sector-new-build.webp" alt="A contemporary glass-fronted new-build house lit from within at dusk, set in wooded grounds." loading="eager">
        <div class="ovsector__head">
          <h3 class="ovsector__title">New-build developments</h3>
          <p class="ovsector__desc">New mains and private supplies designed in from the start of a development, not bolted on after.</p>
        </div>
      </article>
    </div>

    <div class="ovdots" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  </div>
</section>
