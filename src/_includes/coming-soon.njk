---
layout: base.njk
extraStyles: ["contact"]
hideFooterCta: true
robots: "noindex"
---
    <!-- Reuses the thank-you hero treatment so placeholder pages look intentional
         and on-brand rather than broken. Copy is driven by front-matter vars. -->
    <section class="section contact-thanks">
      <div class="container contact-thanks__inner">
        <p class="eyebrow">{{ csEyebrow or "Coming soon" }}</p>
        <h1 class="statement contact-thanks__title">{{ csTitle | safe }}</h1>
        <p class="contact-thanks__lead">{{ csLead }}</p>
        <div class="contact-thanks__actions">
          <a class="btn-inquiry btn-inquiry--lg" href="{{ csPrimaryHref or '/' }}">{{ csPrimaryLabel or 'Back to home' }} <span class="btn-inquiry__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          <a class="btn-line btn-line--lg" href="{{ csSecondaryHref or '/contact/' }}">{{ csSecondaryLabel or 'Contact us' }} <span class="btn-line__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></span></a>
        </div>
      </div>
    </section>
