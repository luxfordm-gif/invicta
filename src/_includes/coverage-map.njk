{#
  Coverage map — an indicative "where we work" heat-map.

  Deliberately impressionistic, not cartographic: soft glows sit at the
  approximate location of real projects (from _data/caseStudies.js), warmest
  where work clusters around the Surrey/Sussex home ground and reaching out to
  Kent, Hampshire, Berkshire and the Cotswolds. No pins, no addresses.

  Self-contained inline SVG — no map tiles, no libraries, no API keys.
  Coordinates: case study map.x/map.y are percentages; ×10 / ×7 map them onto
  the 1000×700 canvas (west→east / north→south).
#}
<section class="section coverage" aria-labelledby="coverage-title">
  <div class="container coverage__inner">
    <div class="coverage__intro">
      <p class="eyebrow">{{ coverageEyebrow or "Where we work" }}</p>
      <h2 id="coverage-title" class="statement coverage__title">{{ coverageTitle | safe or "Systems installed and serviced <span class='em'>across the South East.</span>" }}</h2>
      <p class="coverage__lead">{{ coverageLead or "An indicative picture of where we've designed, installed and looked after private water supplies. Warmer areas are where our work clusters — home ground across Surrey and Sussex, reaching out to Kent, Hampshire, Berkshire and beyond." }}</p>
    </div>

    <figure class="coverage__figure">
      <svg class="coverage__map" viewBox="0 0 1000 700" role="img"
           aria-label="An indicative heat-map of the South East of England showing where Invicta Water Treatment has installed and serviced systems, clustered across Surrey and Sussex and reaching to Kent, Hampshire, Berkshire and the Cotswolds.">
        <defs>
          <radialGradient id="cov-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%"  stop-color="#DCEBF6" stop-opacity="0.95"/>
            <stop offset="32%" stop-color="#8FB6D8" stop-opacity="0.55"/>
            <stop offset="70%" stop-color="#5B76A0" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="#5B76A0" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="cov-sea" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0A1D37"/>
            <stop offset="100%" stop-color="#08182E"/>
          </linearGradient>
          <filter id="cov-bloom" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="10"/>
          </filter>
        </defs>

        <!-- ground -->
        <rect x="0" y="0" width="1000" height="700" fill="url(#cov-sea)"/>

        <!-- stylised landmass (low-contrast, purely to orient the glows) -->
        <g aria-hidden="true" fill="#14294A" fill-opacity="0.5" stroke="#B8C8D4" stroke-opacity="0.10" stroke-width="1.5">
          <path d="M-20,40 L1020,20 L1020,470 Q900,500 860,430 Q840,395 800,470 Q770,540 690,560 Q560,600 470,600 Q360,600 300,640 Q250,672 190,632 Q120,585 96,470 Q70,330 40,250 Q10,150 -20,120 Z"/>
        </g>

        <!-- faint graticule for a 'map' read -->
        <g aria-hidden="true" stroke="#B8C8D4" stroke-opacity="0.07" stroke-width="1">
          <line x1="0" y1="175" x2="1000" y2="175"/>
          <line x1="0" y1="350" x2="1000" y2="350"/>
          <line x1="0" y1="525" x2="1000" y2="525"/>
          <line x1="250" y1="0" x2="250" y2="700"/>
          <line x1="500" y1="0" x2="500" y2="700"/>
          <line x1="750" y1="0" x2="750" y2="700"/>
        </g>

        <!-- heat glows (screen-blended so overlaps brighten into a hot core) -->
        <g style="mix-blend-mode: screen" filter="url(#cov-bloom)">
          {% for cs in caseStudies %}
          {%- set cx = cs.map.x * 10 -%}
          {%- set cy = cs.map.y * 7 -%}
          {%- set r = 120 -%}
          {%- if cs.flagship -%}{%- set r = 168 -%}{%- elif cs.services.length >= 3 -%}{%- set r = 144 -%}{%- endif -%}
          <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r }}" fill="url(#cov-glow)"/>
          {% endfor %}
          {# a little extra warmth over the Surrey/Sussex home ground #}
          <circle cx="560" cy="350" r="150" fill="url(#cov-glow)" opacity="0.7"/>
        </g>

        <!-- location dots + labels -->
        <g class="coverage__points" font-family="Figtree, system-ui, sans-serif">
          {% for cs in caseStudies %}
          {%- set cx = cs.map.x * 10 -%}
          {%- set cy = cs.map.y * 7 -%}
          {%- set anchor = cs.map.anchor or ("end" if cs.map.x > 60 else "start") -%}
          {%- set lx = (cx - 14) if anchor == "end" else (cx + 14) -%}
          {%- set ly = cy + 4 + (cs.map.dy or 0) -%}
          <circle cx="{{ cx }}" cy="{{ cy }}" r="4.5" fill="#F7F7F5"/>
          <circle cx="{{ cx }}" cy="{{ cy }}" r="9" fill="none" stroke="#DCEBF6" stroke-opacity="0.5"/>
          <text x="{{ lx }}" y="{{ ly }}" text-anchor="{{ anchor }}"
                fill="#EAF1F8" font-size="19" font-weight="500" letter-spacing="0.2">{{ cs.location.split(",")[0] }}</text>
          {% endfor %}

          {# home base #}
          <g>
            <circle cx="560" cy="350" r="6.5" fill="#B8C8D4"/>
            <circle cx="560" cy="350" r="13" fill="none" stroke="#B8C8D4" stroke-opacity="0.7" stroke-width="1.5"/>
            <text x="576" y="354" text-anchor="start" fill="#B8C8D4" font-size="18" font-weight="600" letter-spacing="1.2">HORLEY &middot; HQ</text>
          </g>
        </g>
      </svg>
      <figcaption class="coverage__caption">Indicative coverage only — locations are approximate and shown at town or county level.</figcaption>
    </figure>
  </div>
</section>
