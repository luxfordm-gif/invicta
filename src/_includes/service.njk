{#
  CTA LABELS COME FROM FRONT MATTER. Every button on these three pages used to
  read "Enquire now", which names the act of contacting us rather than the
  thing the reader gets, and said the same thing whether the next step was a
  survey, a risk assessment or a service contract. Each page sets its own:

    ctaPrimary   the hero button, and the fallback for the two below
    introCta     under the intro block, once the argument is made
    pointsCta    under "what's involved"

  The default is the survey, because that is the first step on most of them.
#}
{% set ctaLabel = ctaPrimary or "Book a site survey" %}

    {% include "breadcrumb.njk" %}

    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="container hero__inner">
        {# Kept where the label cull took the others out. The H1s on these pages
           are evocative rather than descriptive ("The right system, designed
           around the problem"), so this line is the only place in the page's own
           copy that names the service. #}
        <p class="hero__eyebrow">{{ heroEyebrow }}</p>
        <h1 class="hero__title">{{ heroTitle | safe }}</h1>
        <div class="hero__scroll" aria-hidden="true">
          <svg class="hero__scroll-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v15M6 13l6 6 6-6"/></svg>
        </div>
        <div class="hero__lead">
          <p class="hero__lead-lg">{{ heroLead | safe }}</p>
          {% if heroLeadSm %}<p class="hero__lead-sm">{{ heroLeadSm | safe }}</p>{% endif %}
        </div>

        {# The pair the home and private-supplies heroes carry, for the same
           reason: until now a service page asked for nothing above the fold,
           and the first pressable thing on it was most of a screen further
           down, under the intro. Ranged left against the lead rather than
           centred under it - see .hero__actions in sections.css. #}
        <div class="hero__actions">
          <a class="btn-inquiry btn-inquiry--lg" href="/enquiry/" data-enquiry-open data-enquiry-service="{{ heroEyebrow }}">{{ ctaLabel }} <span class="btn-inquiry__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          <a class="btn-line btn-line--lg" href="tel:{{ site.tel }}" aria-label="Call the 24-hour emergency line on {{ site.phone }}">24hr emergency: {{ site.phone }}</a>
        </div>
      </div>
    </section>

    <!-- ============ WHY IT MATTERS (dark) ============
      Rides off the hero on the same navy, under a divider, so the page answers
      "why would I want this" before it shows a photograph. See service-why.njk.
    -->
{% include "service-why.njk" %}

    <!-- ============ TRUST: THE LOGOS, EARLY ============
      A reader's question after "what is this" is "who else trusts you", and on
      two of these three pages there was no answer anywhere: no logos, no
      figures, nothing but case studies most of a page down. Servicing had the
      band, at position NINE of ten, below the FAQ and the Explore list, where
      a reader who needed convincing had already gone.

      Same slot as /private-water-supplies/: straight after the why-cards,
      before the photographic band. It cannot go between the hero and the
      why-cards, which share the navy deliberately and whose spacing depends on
      `.hero:has(+ .service-why)`; the marks are dark ink at 72% and need the
      pale ground anyway. One clientsId for all three, since a page only ever
      shows the band once.
    -->
    {% set clientsId = "service-clients" %}
    {% set clientsClass = "clients--airy" %}
    {% set clientsSurface = "section--paper" %}
    {% include "clients.njk" %}

    <!-- ============ PROJECT BAND + INTRO (the reveal pair) ============
      The wrapper is load-bearing, not decoration: the band pins itself inside
      it and the intro rides up over the picture, and the wrapper ending is what
      unpins the band again. See service-band.njk.
    -->
    <div class="reveal">
{% include "service-band.njk" %}

    <!-- ===================== INTRO (light) ===================== -->
    {% if introTitle %}
    <section class="section section--paper service-intro" aria-labelledby="intro-title">
      <div class="container">
        <div class="service-intro__inner">
          <h2 id="intro-title" class="statement">{{ introTitle | safe }}</h2>
          {% if introBody %}
          <div class="service-intro__body">
            {% for p in introBody %}<p{% if loop.first %} class="service-intro__lead"{% endif %}>{{ p | safe }}</p>{% endfor %}
          </div>
          {% endif %}
          {# The italic pull-line that used to close this block is gone. It was a
             restatement of the paragraph above it in a bigger face, at the exact
             point in the page where a reader who is convinced wants somewhere to
             go. A button is the more useful thing to put in front of them. #}
          <div class="service-intro__cta">
            <a class="btn-inquiry" href="/enquiry/" data-enquiry-open data-enquiry-service="{{ heroEyebrow }}">{{ introCta or ctaLabel }} <span class="btn-inquiry__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </div>
      </div>
    </section>
    {% endif %}
    </div><!-- /.reveal -->

    <!-- ===================== WHAT'S INVOLVED (dark) ===================== -->
    {% if points %}
    <section class="section service-points" aria-labelledby="points-title">
      <div class="container service-points__grid">
        <aside class="service-points__aside">
          <h2 id="points-title" class="statement">{{ pointsTitle | safe }}</h2>
        </aside>
        <div class="service-points__main">
          <ul class="service-checklist">
            {% for pt in points %}
            <li class="service-check">
              <span class="numeral service-check__index" aria-hidden="true">{{ "0" ~ loop.index }}</span>
              <div class="service-check__text"><span class="service-check__title">{{ pt.title }}</span>{% if pt.desc %}<span class="service-check__desc">{{ pt.desc | safe }}</span>{% endif %}</div>
            </li>
            {% endfor %}
          </ul>
          <div class="service-points__footer">
            {% if pointsLead %}<p class="service-points__lead">{{ pointsLead | safe }}</p>{% endif %}
            {% if pointsApproach %}<p class="service-points__approach">{{ pointsApproach | safe }}</p>{% endif %}
            <a class="btn-inquiry service-points__cta" href="/enquiry/" data-enquiry-open data-enquiry-service="{{ heroEyebrow }}">{{ pointsCta or ctaLabel }} <span class="btn-inquiry__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    {# The shared figures, in the slot /private-water-supplies/ puts them in:
       after the argument, immediately before the case studies they back. These
       three pages had no numbers on them at all — the only proof below the
       fold was the studies themselves. One component, one set of figures, so
       a change to site.stats carries everywhere. #}
    {% include "stats-band.njk" %}

    <!-- ============ CASE STUDIES (bento, cream) ============
      The page's own hand-written `caseStudy` leads, then the studies tagged to
      this service in _data/caseStudies.js. All of them show at once; the grid
      adapts to two or three cards and caps the set at three.
    -->
    {% set serviceSlug = currentService | replace("/services/", "") | replace("/", "") %}
    {% set studies = [] %}
    {% if caseStudy %}{% set _ = studies.push(caseStudy) %}{% endif %}
    {% for cs in caseStudies %}{% if serviceSlug in cs.services %}{% set _ = studies.push(cs) %}{% endif %}{% endfor %}
    {% set carouselId = serviceSlug %}
    {% set bentoSurface = "section--light" %}
    {% set carouselTitle = "Projects like this, <span class='em'>across the South East.</span>" %}
    {% if studies.length > 1 %}
    {% set carouselLead = "A few of the supplies we've designed, installed and looked after." %}
    {% else %}
    {% set carouselLead = "One of the supplies we've designed, installed and looked after." %}
    {% endif %}
    {% include "case-bento.njk" %}

    <!-- ===================== FAQ (dark) ===================== -->
    {% if faqs %}
    <section class="section faq" aria-labelledby="faq-title">
      <div class="container faq__grid">
        <aside class="faq__aside">
          <h2 id="faq-title" class="faq__title">{{ faqTitle or "Frequently asked." }}</h2>
          {% if faqIntro %}<p class="faq__intro">{{ faqIntro }}</p>{% endif %}
        </aside>
        <div class="faq__list">
          {% for f in faqs %}
          <details class="faq__item">
            <summary class="faq__q">
              {{ f.q }}
              <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="faq__a">{{ f.a | safe }}</p>
          </details>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}
