    {% include "breadcrumb.njk" %}

    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="container hero__inner">
        <p class="hero__eyebrow">{{ heroEyebrow }}</p>
        <h1 class="hero__title">{{ heroTitle | safe }}</h1>
        <div class="hero__scroll" aria-hidden="true">
          <svg class="hero__scroll-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v15M6 13l6 6 6-6"/></svg>
        </div>
        <div class="hero__lead">
          <p class="hero__lead-lg">{{ heroLead | safe }}</p>
          {% if heroLeadSm %}<p class="hero__lead-sm">{{ heroLeadSm | safe }}</p>{% endif %}
        </div>
      </div>
    </section>

    <!-- ================ FULL-BLEED PROJECT BAND ================ -->
{% include "service-band.njk" %}

    <!-- ===================== INTRO (light) ===================== -->
    {% if introTitle %}
    <section class="section section--paper service-intro" aria-labelledby="intro-title">
      <div class="container">
        <p class="eyebrow">{{ introEyebrow or "Overview" }}</p>
        <div class="rule"></div>
        <h2 id="intro-title" class="statement">{{ introTitle | safe }}</h2>
        {% if introBody %}
        <div class="service-intro__body">
          {% for p in introBody %}<p>{{ p | safe }}</p>{% endfor %}
        </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <!-- ===================== WHAT'S INVOLVED (dark) ===================== -->
    {% if points %}
    <section class="section service-points" aria-labelledby="points-title">
      <div class="container service-points__grid">
        <aside class="service-points__aside">
          <p class="eyebrow">{{ pointsEyebrow or "What's involved" }}</p>
          <h2 id="points-title" class="statement">{{ pointsTitle | safe }}</h2>
        </aside>
        <div class="service-points__main">
          <ul class="service-checklist">
            {% for pt in points %}
            <li class="service-check">
              <span class="service-check__index" aria-hidden="true">{{ "0" ~ loop.index }}</span>
              <div class="service-check__text"><span class="service-check__title">{{ pt.title }}</span>{% if pt.desc %}<span class="service-check__desc">{{ pt.desc | safe }}</span>{% endif %}</div>
            </li>
            {% endfor %}
          </ul>
          <div class="service-points__footer">
            {% if pointsLead %}<p class="service-points__lead">{{ pointsLead | safe }}</p>{% endif %}
            {% if pointsApproach %}<p class="service-points__approach">{{ pointsApproach | safe }}</p>{% endif %}
            <a class="btn-inquiry service-points__cta" href="/enquiry/" data-enquiry-open data-enquiry-service="{{ heroEyebrow }}">Enquire now <span class="btn-inquiry__arrow" aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    <!-- ============ CASE STUDIES (bento, cream) ============
      The page's own hand-written `caseStudy` leads, then the studies tagged to
      this service in _data/caseStudies.js. All of them show at once; the grid
      adapts to two or three cards and caps the set at three.
    -->
    {% set serviceSlug = currentService | replace("/services/", "") | replace("/", "") %}
    {% set studies = [] %}
    {% if caseStudy %}{% set _ = studies.push(caseStudy) %}{% endif %}
    {% for cs in caseStudies %}{% if serviceSlug in cs.services %}{% set _ = studies.push(cs) %}{% endif %}{% endfor %}
    {% set carouselId = serviceSlug %}
    {% set bentoSurface = "section--light" %}
    {% set carouselEyebrow = "Selected work" %}
    {% set carouselTitle = "Projects like this, <span class='em'>across the South East.</span>" %}
    {% if studies.length > 1 %}
    {% set carouselLead = "A few of the supplies we've designed, installed and looked after." %}
    {% else %}
    {% set carouselLead = "One of the supplies we've designed, installed and looked after." %}
    {% endif %}
    {% include "case-bento.njk" %}

    <!-- ===================== FAQ (dark) ===================== -->
    {% if faqs %}
    <section class="section faq" aria-labelledby="faq-title">
      <div class="container faq__grid">
        <aside class="faq__aside">
          <span class="eyebrow">Common questions</span>
          <h2 id="faq-title" class="faq__title">{{ faqTitle or "Frequently asked." }}</h2>
          {% if faqIntro %}<p class="faq__intro">{{ faqIntro }}</p>{% endif %}
        </aside>
        <div class="faq__list">
          {% for f in faqs %}
          <details class="faq__item">
            <summary class="faq__q">
              {{ f.q }}
              <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="faq__a">{{ f.a | safe }}</p>
          </details>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}
