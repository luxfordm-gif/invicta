<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>document.documentElement.classList.add('js');</script><!-- enables reveal-on-scroll without a flash of hidden content -->

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {# LAUNCH SWITCH: site.indexable in _data/site.json. Live as of 20 Oct 2026
     (true): every page is indexable except those that opt out with
     robots: "noindex" (thank-you, and the 404 via coming-soon.njk), and
     robots.txt opens up and lists the sitemap. Set it to false to hide the
     whole site from search engines again. #}
  {% if not site.indexable %}<meta name="robots" content="noindex, nofollow">
  {% elif robots %}<meta name="robots" content="{{ robots }}">{% endif %}

  <!-- OpenGraph -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_GB">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  {% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
  {# The share picture (14/10/26). A JPEG, not WebP: it is never loaded by a
     visitor to the site, only fetched by WhatsApp, LinkedIn, Facebook and the
     rest, and not all of them accept WebP. 1200x630, the size they all crop
     to. A page can set `ogImage` to use its own. #}
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/og-default.jpg' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogImageAlt or 'A stone terrace in the evening, looking across fields to the hills.' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/assets/og-default.jpg' }}">

  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"><!-- rendered from the SVG at build, see .eleventy.js -->
  <meta name="theme-color" content="#0B1F3A"><!-- == --ground in tokens.css -->

  <!-- Fonts: Figtree (sans) + Playfair Display italic (emotional accent), self-hosted
       (styles/fonts.css). The two latin files are what every visitor needs, so
       they start downloading now rather than after the CSS has been parsed. -->
  <link rel="preload" href="/fonts/figtree-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/playfair-display-italic-latin.woff2" as="font" type="font/woff2" crossorigin>

  {# Styles: one bundle every page shares, then one for this page's extras.
     Minified and content-hashed by the cssBundle filter in .eleventy.js; the
     order here is the cascade order. tooltip.css is site-wide because the
     gloss filter can put a term on any page. #}
  <link rel="stylesheet" href="{{ ['fonts', 'tokens', 'base', 'components', 'sections', 'case-bento', 'stats-band', 'clients', 'enquiry', 'components/tooltip', 'motion'] | cssBundle('site') }}">
  {% if extraStyles and extraStyles.length %}<link rel="stylesheet" href="{{ extraStyles | cssBundle('page') }}">{% endif %}

  <!-- Structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}/#business",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}/",
    "image": "{{ site.url }}/assets/og-default.jpg",
    "telephone": "{{ site.tel }}",
    "email": "{{ site.email }}",
    "areaServed": [{% for c in maps.counties %}"{{ c }}"{% if not loop.last %}, {% endif %}{% endfor %}],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.locality }}",
      "addressRegion": "{{ site.address.region }}",
      "postalCode": "{{ site.address.postcode }}",
      "addressCountry": "GB"
    }
  }
  </script>
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "ubar.njk" %}
  {% include "nav.njk" %}

  <main id="main">
{{ content | gloss | safe }}

{% include "footer.njk" %}
  </main>

{% if not hideEmergencyCta %}{% include "emergency-cta.njk" %}{% endif %}
{% include "enquiry.njk" %}

  {# One deferred bundle of the ten scripts, in their original order (jsBundle
     in .eleventy.js: minified, content-hashed). Each is its own IIFE and
     no-ops on a page without its markup, as they always did. #}
  <script src="{{ ['dots', 'nav', 'carousel', 'filmstrip', 'enquiry', 'forms', 'coverage-band', 'count-up', 'tooltip', 'hero-media', 'motion'] | jsBundle('site') }}" defer></script>
</body>
</html>
