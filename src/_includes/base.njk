<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>document.documentElement.classList.add('js');</script><!-- enables reveal-on-scroll without a flash of hidden content -->

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {# LAUNCH SWITCH: site.indexable in _data/site.json. While it is false the
     whole site is hidden from search engines (it is still only on the
     netlify.app preview URL). Once www.invictawatertreatment.co.uk points at
     Netlify, set it to true: every page becomes indexable except those that
     opt out with robots: "noindex" (thank-you, and the 404 via
     coming-soon.njk), and robots.txt opens up and lists the sitemap. #}
  {% if not site.indexable %}<meta name="robots" content="noindex, nofollow">
  {% elif robots %}<meta name="robots" content="{{ robots }}">{% endif %}

  <!-- OpenGraph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  {% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
  {# The share picture (14/10/26). A JPEG, not WebP: it is never loaded by a
     visitor to the site, only fetched by WhatsApp, LinkedIn, Facebook and the
     rest, and not all of them accept WebP. 1200x630, the size they all crop
     to. A page can set `ogImage` to use its own. #}
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/og-default.jpg' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogImageAlt or 'A stone terrace in the evening, looking across fields to the hills.' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/assets/og-default.jpg' }}">

  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#0D3159">

  <!-- Fonts: Figtree (sans) + Playfair Display italic (emotional accent) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Playfair+Display:ital,wght@1,400;1,500;1,600&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="{{ '/styles/tokens.css' | v }}">
  <link rel="stylesheet" href="{{ '/styles/base.css' | v }}">
  <link rel="stylesheet" href="{{ '/styles/components.css' | v }}">
  <link rel="stylesheet" href="{{ '/styles/sections.css' | v }}">
  <link rel="stylesheet" href="{{ '/styles/case-bento.css' | v }}">
  <link rel="stylesheet" href="{{ '/styles/stats-band.css' | v }}">
  <link rel="stylesheet" href="{{ '/styles/clients.css' | v }}">
  {% for s in extraStyles %}<link rel="stylesheet" href="{{ ('/styles/' + s + '.css') | v }}">
  {% endfor %}<link rel="stylesheet" href="{{ '/styles/enquiry.css' | v }}">
  <link rel="stylesheet" href="{{ '/styles/components/tooltip.css' | v }}"><!-- site-wide: the gloss filter can put a term on any page -->
  <link rel="stylesheet" href="{{ '/styles/motion.css' | v }}">

  <!-- Structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "{{ site.name }}",
    "telephone": "{{ site.tel }}",
    "email": "{{ site.email }}",
    "areaServed": [{% for c in maps.counties %}"{{ c }}"{% if not loop.last %}, {% endif %}{% endfor %}],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.locality }}",
      "addressRegion": "{{ site.address.region }}",
      "postalCode": "{{ site.address.postcode }}",
      "addressCountry": "GB"
    }
  }
  </script>
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "ubar.njk" %}
  {% include "nav.njk" %}

  <main id="main">
{{ content | gloss | safe }}

{% include "footer.njk" %}
  </main>

{% if not hideEmergencyCta %}{% include "emergency-cta.njk" %}{% endif %}
{% include "enquiry.njk" %}

  <script src="{{ '/scripts/nav.js' | v }}" defer></script>
  <script src="{{ '/scripts/carousel.js' | v }}" defer></script>
  <script src="{{ '/scripts/filmstrip.js' | v }}" defer></script>
  <script src="{{ '/scripts/enquiry.js' | v }}" defer></script>
  <script src="{{ '/scripts/forms.js' | v }}" defer></script>
  <script src="{{ '/scripts/coverage-band.js' | v }}" defer></script>
  <script src="{{ '/scripts/count-up.js' | v }}" defer></script>
  <script src="{{ '/scripts/tooltip.js' | v }}" defer></script>
  <script src="{{ '/scripts/hero-media.js' | v }}" defer></script>
  <script src="{{ '/scripts/motion.js' | v }}" defer></script>
</body>
</html>
