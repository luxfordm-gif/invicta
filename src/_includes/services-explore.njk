    <!-- ===================== EXPLORE OTHER SERVICES (internal links) ===================== -->
    <section class="section services-explore" aria-labelledby="explore-title">
      <div class="container">
        <p class="eyebrow">More from Invicta</p>
        <h2 id="explore-title" class="statement">Explore our other services.</h2>
        <p class="services-explore__lead">Water treatment is only ever part of the picture. Whatever your property needs, it is looked after by the same team.</p>
        <ul class="services-explore__tags">
          {% for s in site.services %}
          {% if s.href != currentService %}
          <li>
            <a class="tag" href="{{ s.href }}">
              <span>{{ s.title }}</span>
              <span class="tag__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
          {% endif %}
          {% endfor %}
        </ul>
      </div>
    </section>
