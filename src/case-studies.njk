---
layout: base.njk
title: "Case Studies | Private Water Supply Projects | Invicta Water Treatment"
description: "Real private water supply projects across the South East, from a National Trust restoration to multi-source estate systems, boreholes, ultrafiltration and EHO-passing supplies. Locations shown at town or county level."
canonical: "https://www.invictawatertreatment.co.uk/case-studies/"
permalink: "/case-studies/"
current: "case-studies"
extraStyles: ["casestudies"]
---
{% set svcLabels = {
  "private-water-supplies": "Private Water Supplies",
  "design-install": "Design & Install",
  "servicing": "Servicing & Maintenance",
  "water-hygiene": "Water Hygiene"
} %}

    <!-- ===================== HERO (dark) ===================== -->
    <section class="section cs-hero" aria-labelledby="cs-hero-title">
      <div class="container">
        <p class="eyebrow">Our work</p>
        <h1 class="statement cs-hero__title">Systems we've designed, installed <span class="em">and looked after.</span></h1>
        <p class="cs-hero__lead">A selection of private water supply projects across the South East, from a National Trust restoration to multi-source estate systems. Clients are kept anonymous and locations are shown at town or county level.</p>
      </div>
    </section>

    <!-- ===================== COVERAGE HEAT-MAP (dark) ===================== -->
    {% set coverageEyebrow = "Coverage" %}
    {% set coverageTitle = "Where these projects <span class='em'>sit on the map.</span>" %}
    {% include "coverage-map.njk" %}

    <!-- ===================== CASE STUDIES LIST (light) ===================== -->
    <section class="section section--light cs-list" aria-label="Case studies">
      <div class="container">
        {% for cs in caseStudies %}
        <article class="cs-entry{% if cs.flagship %} cs-entry--flagship{% endif %}" id="{{ cs.id }}">
          <figure class="cs-entry__media">
            {% if cs.image %}
            <img src="{{ cs.image }}" alt="{{ cs.imageAlt or (cs.name + ', ' + cs.location) }}" loading="lazy">
            {% else %}
            <div class="img-ph" role="img" aria-label="Project photo to follow">
              <span class="img-ph__label">Photo to follow</span>
            </div>
            {% endif %}
            <figcaption class="cs-entry__pin">{{ cs.location }}</figcaption>
          </figure>

          <div class="cs-entry__text">
            {% if cs.flagship %}<p class="cs-entry__flag">Flagship project</p>{% endif %}
            <p class="eyebrow">{{ cs.county }}</p>
            <h2 class="cs-entry__name">{{ cs.name }}</h2>
            <div class="cs-entry__body">
              {% for p in cs.body %}<p>{{ p }}</p>{% endfor %}
            </div>
            {% if cs.highlight %}<p class="cs-entry__highlight">{{ cs.highlight }}</p>{% endif %}
            <ul class="cs-entry__tags">
              {% for s in cs.services %}<li>{{ svcLabels[s] }}</li>{% endfor %}
            </ul>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>
